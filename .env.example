# ============================================================
# VisiTrack — Environment Configuration
# ============================================================
# Copy this file to .env and customize as needed.
# All values shown are the defaults.
# ============================================================

# ── GPU / Device ─────────────────────────────────────────────
DEVICE=cuda
CUDA_DEVICE_INDEX=0
USE_HALF_PRECISION=true
USE_GPU_DECODING=true
ALLOW_CPU_FALLBACK=false

# ── Batch Sizes ──────────────────────────────────────────────
DETECTION_BATCH_SIZE=1
FACE_BATCH_SIZE=16
REID_BATCH_SIZE=16

# ── GPU Memory ───────────────────────────────────────────────
# Set to 0 for unlimited, or a value in MB to limit usage.
GPU_MEMORY_LIMIT_MB=0

# ── Optional Optimizations ───────────────────────────────────
ENABLE_TENSORRT=false
ENABLE_TORCH_COMPILE=false

# Uncomment to override autocast dtype (default: auto-detect)
# AUTOCAST_DTYPE=fp16
# AUTOCAST_DTYPE=bf16

# ── Video / RTSP ─────────────────────────────────────────────
RTSP_URL=rtsp://admin:password@192.168.1.100:554/stream
FRAME_SKIP=0
QUEUE_MAX_SIZE=2
RECONNECT_DELAY=2.0
MAX_RECONNECT_DELAY=60.0

# ── Detection / Recognition Thresholds ───────────────────────
DETECTION_CONFIDENCE=0.5
FACE_DETECTION_THRESHOLD=0.5
REID_MATCH_THRESHOLD=0.6

# ── Performance Monitoring ───────────────────────────────────
PERF_LOG_INTERVAL=30

# ── Model Overrides ─────────────────────────────────────────
# RFDETR_WEIGHTS=          # Path to custom RF-DETR weights
FACE_MODEL_NAME=buffalo_l
REID_MODEL_NAME=osnet_x1_0

# ── Tracker ──────────────────────────────────────────────────
TRACK_MAX_AGE=30
TRACK_MIN_HITS=3
TRACK_IOU_THRESHOLD=0.3
